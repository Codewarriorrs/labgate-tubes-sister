# ============================================================
# LabGate Cloud Service - Environment Variables Template
# ============================================================
# Salin file ini menjadi `.env.local` di dalam folder `apps/cloud/`
# Atau masukkan variabel ini ke Project Settings > Environment Variables di Vercel.

# 1. Database PostgreSQL (Neon / Supabase / AWS RDS / Lokal)
# Contoh Neon Database URL:
DATABASE_URL="postgresql://neondb_owner:npg_xxxxxx@ep-cool-project-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. Keamanan Auth & Token JWT
JWT_SECRET="ganti-dengan-kunci-rahasia-jwt-minimal-32-karakter-acak"

# 3. Pepper Hash UID Kartu KTM RFID (SHA-256 + Pepper)
CARD_PEPPER="labgate_undip_tembalang_secure_pepper_2026"

# 4. Kunci Ed25519 Tiket QR (Opsional: jika kosong, Cloud generate otomatis saat booting)
# QR_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# QR_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

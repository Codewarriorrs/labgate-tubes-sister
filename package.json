{
  "name": "labgate-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:cloud": "npm --workspace=apps/cloud run dev",
    "dev:gateway": "npm --workspace=apps/gateway run dev",
    "build": "npm --workspaces --if-present run build",
    "test": "npm --workspaces --if-present run test"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
